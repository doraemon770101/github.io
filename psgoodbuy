        cart: [],
        form: { name: '', phone: '', shipping: '7-11 超商取貨', address: '' },
        isSubmitting: false,

        get filteredProducts() {
          return this.currentCategory === 'all' ? this.products : this.products.filter(p => p.category === this.currentCategory);
        },
        get totalCount() { return this.cart.reduce((s, i) => s + i.qty, 0); },
        get totalPrice() { return this.cart.reduce((s, i) => s + (i.price * i.qty), 0); },

        openModal(product) {
          product.currentImageIdx = 0;
          this.activeModalProduct = product;
        },

        addToCart(product) {
          let itemPrice = product.price;
          let itemName = product.name;

          if (product.variants) {
            const selected = product.variants[product.selectedVariant];
            itemPrice = selected.price;
            itemName = `${product.name} (${selected.size})`;
          }

          const idx = this.cart.findIndex(i => i.name === itemName);
          if (idx > -1) {
            this.cart[idx].qty++;
          } else {
            this.cart.push({ name: itemName, price: itemPrice, qty: 1 });
          }
        },

        removeItem(index) { this.cart.splice(index, 1); },

        submitOrder() {
          if (this.cart.length === 0) return alert('購物車是空的！');
          this.isSubmitting = true;

          const GOOGLE_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbw6bM9kHFlD6Nc5rHGZojcSeVdGTYx3ltW9tRmT7J8ysXapGR_-PBcPClAR9mjjdHRAAQ/exec';

          const itemList = this.cart.map(i => `${i.name} x${i.qty}`).join('; ');
          const payload = {
            name: this.form.name,
            phone: this.form.phone,
            shipping: this.form.shipping,
            address: this.form.address,
            items: itemList,
            total: this.totalPrice
          };

          fetch(GOOGLE_SCRIPT_URL, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          })
          .then(() => {
            alert(`🎉 訂單已成功送出！\n\n感謝您的購買，${this.form.name}！我們將以【隱密無字樣包裝】盡快為您安排出貨。`);
            this.cart = [];
            this.form = { name: '', phone: '', shipping: '7-11 超商取貨', address: '' };
          })
          .catch(error => {
            alert('訂單送出失敗，請稍後再試。');
            console.error('Error:', error);
          })
          .finally(() => {
            this.isSubmitting = false;
          });
        }
      }
