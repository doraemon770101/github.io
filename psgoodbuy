<!DOCTYPE html>
<html lang="zh-TW" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>P.S健康莊園 - MEET UR BEST SELF</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Tailwind 顏色與風格設定 -->
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              bg: '#0A2526',       // 深墨綠背景
              card: '#123233',     // 卡片深綠
              accent: '#E5C467',   // 香檳金
              hover: '#D4B152',    // 金色 Hover
              text: '#F1F5F9',     // 主文字（白/淺灰）
              muted: '#94A3B8'     // 次要文字
            }
          }
        }
      }
    }
  </script>
  <!-- FontAwesome 圖示 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Alpine.js -->
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <style>
    [x-cloak] { display: none !important; }
  </style>
</head>
<body class="bg-brand-bg text-brand-text font-sans min-h-screen relative flex flex-col justify-between" x-data="shopApp()">

  <div>
    <!-- 頂部固定導覽列 -->
    <header class="sticky top-0 bg-[#0A2526]/90 backdrop-blur-md border-b border-[#E5C467]/20 z-50">
      <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">
        <a href="#" class="text-2xl font-bold text-brand-accent tracking-widest flex items-center gap-2">
          <span class="font-serif italic text-3xl">ps.</span>
          <span class="text-lg tracking-wider font-semibold border-l border-[#E5C467]/40 pl-2">P.S健康莊園</span>
        </a>
        <a href="#checkout" class="relative bg-brand-accent hover:bg-brand-hover text-slate-950 font-bold px-5 py-2 rounded-full flex items-center space-x-2 transition shadow-lg shadow-brand-accent/10">
          <i class="fa-solid fa-cart-shopping"></i>
          <span>購物車</span>
          <span x-show="totalCount > 0" x-text="totalCount" class="bg-rose-600 text-white text-xs font-bold rounded-full h-5 w-5 flex items-center justify-center">0</span>
        </a>
      </div>
    </header>

    <!-- 首頁 Banner -->
    <section class="py-16 px-4 text-center relative overflow-hidden">
      <div class="max-w-3xl mx-auto space-y-6">
        <div class="inline-block border border-brand-accent/40 bg-brand-accent/5 px-6 py-2 rounded-full">
          <span class="text-brand-accent tracking-widest text-sm font-semibold uppercase">MEET UR BEST SELF.</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-black text-white tracking-tight leading-tight">
          遇見最好的自己<br><span class="text-brand-accent font-light text-2xl md:text-3xl">質感保健 · 嚴選保養 · 專業輔具</span>
        </h1>
        <p class="text-brand-muted text-base max-w-xl mx-auto font-light">
          嚴選專利配方與知名品牌私密保養，全程採用【無字樣隱密包裝】寄送，貼心守護您的個人隱私。
        </p>
      </div>
    </section>

    <!-- 商品選購區 -->
    <section class="max-w-6xl mx-auto py-6 px-4">
      <!-- 分類 Tab 按鈕 -->
      <div class="flex justify-center gap-3 mb-10 flex-wrap">
        <template x-for="cat in categories" :key="cat.id">
          <button 
            @click="currentCategory = cat.id"
            :class="currentCategory === cat.id ? 'bg-brand-accent text-slate-950 font-bold shadow-lg shadow-brand-accent/20' : 'bg-brand-card text-brand-text hover:bg-slate-800 border border-[#E5C467]/20'"
            class="px-6 py-2.5 rounded-full text-sm transition-all tracking-wider">
            <span x-text="cat.name"></span>
          </button>
        </template>
      </div>

      <!-- 商品網格 -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <template x-for="product in filteredProducts" :key="product.id">
          <div class="bg-brand-card border border-[#E5C467]/20 rounded-2xl p-5 hover:border-brand-accent/60 transition-all duration-300 flex flex-col justify-between shadow-xl overflow-hidden group">
            <div>
              <!-- 商品圖片展示區 -->
              <div class="w-full h-56 bg-white rounded-xl overflow-hidden mb-4 flex items-center justify-center p-2 relative">
                <template x-if="product.image">
                  <img :src="product.image" :alt="product.name" class="h-full object-contain group-hover:scale-105 transition-transform duration-300">
                </template>
                <template x-if="!product.image">
                  <div class="flex flex-col items-center justify-center text-slate-400">
                    <i class="fa-solid fa-box-open text-4xl mb-2"></i>
                    <span class="text-xs">精緻隱密包裝</span>
                  </div>
                </template>
              </div>

              <div class="flex justify-between items-start mb-3">
                <span class="text-xs bg-brand-accent/20 text-brand-accent border border-brand-accent/30 px-3 py-1 rounded-full font-semibold" x-text="product.tag"></span>
                <span x-show="product.variants" class="text-xs text-brand-muted border border-slate-700 px-2 py-0.5 rounded">多尺寸可選</span>
              </div>
              <h3 class="font-bold text-lg text-white mb-2 tracking-wide cursor-pointer hover:text-brand-accent transition line-clamp-1" @click="openModal(product)" x-text="product.name"></h3>
              <p class="text-brand-muted text-sm line-clamp-2 mb-6 font-light leading-relaxed" x-text="product.desc"></p>
            </div>

            <div>
              <!-- 多規格選擇 -->
              <div x-show="product.variants" class="mb-4">
                <label class="block text-xs text-brand-muted mb-1 font-semibold">選擇規格：</label>
                <select x-model="product.selectedVariant" class="w-full bg-[#0A2526] border border-[#E5C467]/30 rounded-lg px-3 py-2 text-xs text-brand-accent focus:outline-none">
                  <template x-for="(v, idx) in product.variants" :key="idx">
                    <option :value="idx" x-text="`${v.size} - NT$ ${v.price}`"></option>
                  </template>
                </select>
              </div>

              <div class="flex items-baseline space-x-2 mb-4">
                <span class="text-2xl font-black text-brand-accent">
                  NT$ <span x-text="product.variants ? product.variants[product.selectedVariant].price : product.price"></span>
                </span>
              </div>

              <div class="flex gap-2">
                <button @click="openModal(product)" class="bg-slate-800 hover:bg-slate-700 text-brand-text text-sm px-4 py-3 rounded-xl transition border border-[#E5C467]/20">
                  <i class="fa-solid fa-circle-info mr-1"></i> 詳情
                </button>
                <button @click="addToCart(product)" class="flex-1 bg-brand-accent hover:bg-brand-hover text-slate-950 font-bold py-3 rounded-xl transition tracking-wider">
                  <i class="fa-solid fa-cart-plus mr-1"></i> 加入購物車
                </button>
              </div>
            </div>
          </div>
        </template>
      </div>
    </section>

    <!-- 商品詳情 Modal -->
    <div x-show="activeModalProduct" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm" x-cloak>
      <div @click.away="activeModalProduct = null" class="bg-brand-card border border-[#E5C467]/40 rounded-2xl max-w-2xl w-full max-h-[85vh] overflow-y-auto p-6 md:p-8 relative shadow-2xl">
        <button @click="activeModalProduct = null" class="absolute top-4 right-4 text-brand-muted hover:text-white text-xl p-2 z-10">
          <i class="fa-solid fa-xmark"></i>
        </button>
        <template x-if="activeModalProduct">
          <div class="space-y-6">
            <!-- 單圖顯示或多圖縮圖展示區 -->
            <template x-if="activeModalProduct.image">
              <div class="space-y-3">
                <div class="w-full h-64 bg-white rounded-xl overflow-hidden flex items-center justify-center p-4">
                  <img :src="activeModalProduct.images ? activeModalProduct.images[activeModalProduct.currentImageIdx || 0] : activeModalProduct.image" :alt="activeModalProduct.name" class="h-full object-contain">
                </div>
                <!-- 多張圖片縮圖切換區 -->
                <template x-if="activeModalProduct.images && activeModalProduct.images.length > 1">
                  <div class="flex gap-2 overflow-x-auto pb-1 justify-center">
                    <template x-for="(img, idx) in activeModalProduct.images" :key="idx">
                      <button @click="activeModalProduct.currentImageIdx = idx" class="w-16 h-16 rounded-lg bg-white border-2 overflow-hidden flex-shrink-0 transition" :class="(activeModalProduct.currentImageIdx || 0) === idx ? 'border-brand-accent scale-105' : 'border-transparent opacity-70 hover:opacity-100'">
                        <img :src="img" class="w-full h-full object-contain">
                      </button>
                    </template>
                  </div>
                </template>
              </div>
            </template>
            <div>
              <span class="text-xs bg-brand-accent/20 text-brand-accent px-3 py-1 rounded-full font-semibold" x-text="activeModalProduct.tag"></span>
              <h2 class="text-2xl font-bold text-white mt-3" x-text="activeModalProduct.name"></h2>
              <p class="text-brand-muted text-sm mt-2 leading-relaxed" x-text="activeModalProduct.desc"></p>
            </div>

            <div class="border-t border-b border-[#E5C467]/20 py-4 space-y-3">
              <h4 class="font-bold text-brand-accent text-base"><i class="fa-solid fa-star mr-1"></i> 商品特色與銷售重點</h4>
              <p class="whitespace-pre-line text-sm text-slate-300 leading-relaxed font-light" x-text="activeModalProduct.detail"></p>
            </div>

            <div class="flex items-center justify-between pt-2">
              <div class="text-3xl font-black text-brand-accent">
                NT$ <span x-text="activeModalProduct.variants ? activeModalProduct.variants[activeModalProduct.selectedVariant].price : activeModalProduct.price"></span>
              </div>
              <button @click="addToCart(activeModalProduct); activeModalProduct = null;" class="bg-brand-accent hover:bg-brand-hover text-slate-950 font-bold px-8 py-3 rounded-xl transition">
                <i class="fa-solid fa-cart-plus mr-1"></i> 加入購物車
              </button>
            </div>
          </div>
        </template>
      </div>
    </div>

    <!-- 購物車與結帳區 -->
    <section id="checkout" class="max-w-4xl mx-auto my-16 px-4">
      <div class="bg-brand-card border border-[#E5C467]/30 rounded-2xl p-6 md:p-10 shadow-2xl">
        <h2 class="text-2xl font-bold text-white mb-8 border-b border-[#E5C467]/20 pb-4 flex items-center gap-2">
          <i class="fa-solid fa-receipt text-brand-accent"></i> 訂單結帳
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
          <!-- 左側：購物車明細 -->
          <div>
            <h3 class="font-semibold text-brand-text mb-4 tracking-wider">已選擇商品：</h3>
            <div x-show="cart.length === 0" class="text-brand-muted py-12 text-center border border-dashed border-[#E5C467]/20 rounded-xl">
              <i class="fa-solid fa-basket-shopping text-3xl mb-2 text-brand-accent/40"></i>
              <p>購物車目前是空的</p>
            </div>
            <div class="space-y-3 max-h-64 overflow-y-auto pr-2">
              <template x-for="(item, index) in cart" :key="index">
                <div class="flex justify-between items-center bg-[#0A2526]/80 p-3.5 rounded-xl border border-[#E5C467]/20">
                  <div>
                    <div class="text-sm font-bold text-white" x-text="item.name"></div>
                    <div class="text-xs text-brand-accent mt-0.5">NT$ <span x-text="item.price"></span> x <span x-text="item.qty"></span></div>
                  </div>
                  <button @click="removeItem(index)" class="text-slate-500 hover:text-rose-400 transition px-2"><i class="fa-solid fa-trash"></i></button>
                </div>
              </template>
            </div>
            <div x-show="cart.length > 0" class="mt-6 pt-4 border-t border-[#E5C467]/20 flex justify-between font-bold text-xl text-brand-accent">
              <span>總金額：</span>
              <span>NT$ <span x-text="totalPrice"></span></span>
            </div>
          </div>

          <!-- 右側：顧客資料表單 -->
          <form @submit.prevent="submitOrder()" class="space-y-4">
            <div>
              <label class="block text-xs font-semibold text-brand-muted mb-1">收件人姓名 *</label>
              <input type="text" x-model="form.name" required placeholder="請輸入姓名" class="w-full bg-[#0A2526] border border-[#E5C467]/30 rounded-lg px-3.5 py-2.5 text-sm text-white focus:border-brand-accent focus:outline-none">
            </div>
            <div>
              <label class="block text-xs font-semibold text-brand-muted mb-1">聯絡電話 *</label>
              <input type="tel" x-model="form.phone" required placeholder="0912345678" class="w-full bg-[#0A2526] border border-[#E5C467]/30 rounded-lg px-3.5 py-2.5 text-sm text-white focus:border-brand-accent focus:outline-none">
            </div>
            <div>
              <label class="block text-xs font-semibold text-brand-muted mb-1">配送方式 *</label>
              <select x-model="form.shipping" class="w-full bg-[#0A2526] border border-[#E5C467]/30 rounded-lg px-3.5 py-2.5 text-sm text-white focus:border-brand-accent focus:outline-none">
                <option value="7-11 超商取貨">7-11 超商取貨</option>
                <option value="全家 超商取貨">全家 超商取貨</option>
                <option value="宅配到府">宅配到府</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-brand-muted mb-1">取貨門市 / 宅配地址 *</label>
              <input type="text" x-model="form.address" required placeholder="門市名稱/店號 或 詳細地址" class="w-full bg-[#0A2526] border border-[#E5C467]/30 rounded-lg px-3.5 py-2.5 text-sm text-white focus:border-border-brand-accent focus:outline-none">
              <div class="text-[11px] text-brand-muted mt-1.5 space-x-2">
                <span>門市查詢：</span>
                <a href="https://emap.pcsc.com.tw" target="_blank" class="text-brand-accent underline hover:text-brand-hover">7-11 門市</a>
                <a href="https://www.family.com.tw/Marketing/zh/Map" target="_blank" class="text-brand-accent underline hover:text-brand-hover">全家 門市</a>
              </div>
            </div>

            <button 
              type="submit" 
              :disabled="cart.length === 0 || isSubmitting" 
              :class="(cart.length === 0 || isSubmitting) ? 'bg-slate-700 cursor-not-allowed' : 'bg-brand-accent hover:bg-brand-hover text-slate-950'" 
              class="w-full font-bold py-3.5 rounded-xl transition mt-6 flex justify-center items-center gap-2 shadow-lg tracking-wider">
              <span x-show="isSubmitting"><i class="fa-solid fa-spinner fa-spin"></i> 送出中...</span>
              <span x-show="!isSubmitting">確認送出訂單</span>
            </button>
          </form>
        </div>
      </div>
    </section>
  </div>

  <!-- 頁尾法定資訊區 -->
  <footer class="bg-[#061819] border-t border-[#E5C467]/20 py-10 px-4 mt-12 text-center text-xs text-brand-muted">
    <div class="max-w-4xl mx-auto space-y-3 font-light leading-relaxed">
      <div class="flex flex-col md:flex-row justify-center items-center gap-2 md:gap-6 font-normal text-slate-300">
        <span>◆ 醫療材商名稱：宸睿生醫有限公司</span>
        <span>◆ 統一編號：62140239</span>
        <span>◆ 醫療材商諮詢專線：0966-087-237</span>
      </div>
      <div>◆ 醫療材商地址：臺北市萬華區康定路116號7樓之4</div>
      <div class="flex flex-col md:flex-row justify-center items-center gap-2 md:gap-6">
        <span>◆ 醫療材商許可證字號：北市衛器販（萬）字第MD6201098413號</span>
        <span>◆ 藥商許可執照字號：北市衛食藥字第11530229299號</span>
      </div>
      <div class="pt-2 text-brand-accent/80 font-medium tracking-wider">
        ◆ 消費者使用前應詳閱醫療器材以及保健食品說明書
      </div>
      <div class="pt-4 text-[10px] text-slate-600 border-t border-slate-800/80 max-w-md mx-auto">
        &copy; P.S健康莊園 All Rights Reserved.
      </div>
    </div>
  </footer>

